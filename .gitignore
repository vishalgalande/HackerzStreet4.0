# ==========================
# .gitignore — HackerzStreet
# ==========================

# ----- Dependencies -----
node_modules/
vendor/
__pycache__/
*.pyc
.venv/
venv/
env/

# ----- Environment -----
.env
.env.local
.env.*.local

# ----- Build Output -----
dist/
build/
out/
*.egg-info/

# ----- OS Files -----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# ----- IDE / Editor -----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- Misc -----
*.tmp
*.bak
*.orig
coverage/
.cache/
