# ==================================
# Environment Variables — HackerzStreet
# ==================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit your .env file — it is gitignored.
# ✅  Only commit changes to .env.example (this file).
# ==================================

# ----- General -----
NODE_ENV=development
PORT=3000

# ----- Database -----
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=hackerzstreet
# DB_USER=
# DB_PASSWORD=

# ----- API Keys -----
# API_KEY=
# API_SECRET=

# ----- Auth -----
# JWT_SECRET=
# SESSION_SECRET=

# ----- Third-Party Services -----
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ----- Frontend (if needed) -----
# VITE_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
